{
  "openapi": "3.1.0",
  "info": {
    "title": "ZipViz Registry API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.zipviz.ai"
    }
  ],
  "paths": {
    "/v1/health": {
      "get": {
        "summary": "Registry health",
        "responses": {
          "200": {
            "description": "Healthy"
          }
        }
      }
    },
    "/v1/agent/{domain}": {
      "get": {
        "summary": "Look up a registered agent",
        "parameters": [
          {
            "in": "path",
            "name": "domain",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Registered agent row, plus the additive proven_by provenance list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "proven_by": {
                      "type": "array",
                      "description": "Provenance of the canonical .viz name: what has been proven for it and when. Empty when nothing is recorded. Ordered by verified_at then id. A stale entry is shown, never hidden, and never changes \"verified\". A revoked entry is never reported.",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "type",
                          "subject",
                          "status",
                          "verified_at"
                        ],
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "operator",
                              "invite",
                              "namespace",
                              "ans",
                              "dns",
                              "nostr_link",
                              "handshake"
                            ]
                          },
                          "subject": {
                            "type": "string",
                            "description": "What is proven, normalised to lower case with no trailing dot: the outside name for an external type, and the literal \"operator\" or \"invite\" for an internal registration marker. The issuing .viz name behind an invite is never reported."
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "active",
                              "stale",
                              "revoked"
                            ]
                          },
                          "verified_at": {
                            "type": "integer",
                            "description": "Epoch milliseconds, as elsewhere in the registry."
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Agent not found"
          }
        }
      }
    },
    "/v1/agent/{domain}/card": {
      "get": {
        "summary": "Read the public agent card",
        "parameters": [
          {
            "in": "path",
            "name": "domain",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Legacy card, optionally with the exact top-level agent_conversations declaration, plus the additive proven_by provenance list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "proven_by": {
                      "type": "array",
                      "description": "Provenance of the canonical .viz name: what has been proven for it and when. Empty when nothing is recorded. Ordered by verified_at then id. A stale entry is shown, never hidden, and never changes \"verified\". A revoked entry is never reported.",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "type",
                          "subject",
                          "status",
                          "verified_at"
                        ],
                        "properties": {
                          "type": {
                            "type": "string",
                            "enum": [
                              "operator",
                              "invite",
                              "namespace",
                              "ans",
                              "dns",
                              "nostr_link",
                              "handshake"
                            ]
                          },
                          "subject": {
                            "type": "string",
                            "description": "What is proven, normalised to lower case with no trailing dot: the outside name for an external type, and the literal \"operator\" or \"invite\" for an internal registration marker. The issuing .viz name behind an invite is never reported."
                          },
                          "status": {
                            "type": "string",
                            "enum": [
                              "active",
                              "stale",
                              "revoked"
                            ]
                          },
                          "verified_at": {
                            "type": "integer",
                            "description": "Epoch milliseconds, as elsewhere in the registry."
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Agent not found"
          }
        }
      }
    },
    "/v1/agent/{domain}/address": {
      "post": {
        "summary": "Set the public card URL with the agent key",
        "description": "Dormant unless AGENT_ADDRESS_UPDATE_ENABLED is exactly true; disabled requests return 503 E_ADDRESS_DISABLED. Signed by the current registered Ed25519 key. The registration bearer is ignored. Signed bytes are UTF-8 JSON with fields in exact order v, op, aud, domain, new_url, timestamp, nonce. aud is the configured registry audience, never the Host header; timestamp expires after 60 seconds. new_url is a canonical bare HTTPS origin. After public A/AAAA checks, the registry GETs /.well-known/zipviz/endpoint-proof with domain and a 32-byte base64url challenge. The entire 200 application/json body must be the byte-exact RFC 8785 canonical serialization of the full proof object, including signature; whitespace, alternate member order and duplicates are refused. The closed-schema proof signature covers \"ZipViz endpoint-proof v1\\0\" plus RFC 8785 JCS of the object without signature, using the same current key. The proof origin, domain, challenge, configured audience and issued_at_ms within 60 seconds must match.",
        "security": [],
        "parameters": [
          {
            "in": "path",
            "name": "domain",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "v",
                  "op",
                  "aud",
                  "domain",
                  "new_url",
                  "timestamp",
                  "nonce",
                  "signature"
                ],
                "properties": {
                  "v": {
                    "type": "integer",
                    "const": 1
                  },
                  "op": {
                    "type": "string",
                    "const": "address.set"
                  },
                  "aud": {
                    "type": "string",
                    "enum": [
                      "api.zipviz.ai",
                      "api-staging.zipviz.ai"
                    ],
                    "description": "Configured registry audience; never inferred from Host."
                  },
                  "domain": {
                    "type": "string",
                    "description": "The same current .viz identity as the route."
                  },
                  "new_url": {
                    "type": "string",
                    "format": "uri",
                    "description": "Canonical bare HTTPS origin on port 443: exactly URL(new_url).origin, with no trailing slash."
                  },
                  "timestamp": {
                    "type": "string",
                    "format": "date-time",
                    "description": "Canonical UTC ISO timestamp with milliseconds, accepted for exactly ±60 seconds."
                  },
                  "nonce": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{16,64}$"
                  },
                  "signature": {
                    "type": "string",
                    "pattern": "^[0-9a-fA-F]{128}$",
                    "description": "Ed25519 signature by the current registered key."
                  }
                }
              }
            }
          }
        },
        "x-zipviz-endpoint-proof": {
          "method": "GET",
          "path": "/.well-known/zipviz/endpoint-proof",
          "query": [
            "domain",
            "challenge"
          ],
          "timeout_ms": 5000,
          "max_response_bytes": 8192,
          "redirects": "manual-refuse",
          "response_schema": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schema_version",
              "type",
              "domain",
              "endpoint",
              "challenge",
              "audience",
              "issued_at_ms",
              "signature"
            ],
            "properties": {
              "schema_version": {
                "type": "string",
                "const": "1.0"
              },
              "type": {
                "type": "string",
                "const": "zipviz.endpoint.proof"
              },
              "domain": {
                "type": "string"
              },
              "endpoint": {
                "type": "string",
                "format": "uri",
                "description": "Mailbox-configured canonical origin, never derived from Host."
              },
              "challenge": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{43}$"
              },
              "audience": {
                "type": "string",
                "enum": [
                  "api.zipviz.ai",
                  "api-staging.zipviz.ai"
                ]
              },
              "issued_at_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "signature": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "alg",
                  "key_id",
                  "value_base64url"
                ],
                "properties": {
                  "alg": {
                    "type": "string",
                    "const": "Ed25519"
                  },
                  "key_id": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "value_base64url": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{86}$"
                  }
                }
              }
            }
          },
          "raw_response_serialization": {
            "scope": "entire 200 application/json body, full proof object including signature",
            "canonicalization": "RFC8785",
            "byte_exact": true,
            "whitespace": "forbidden",
            "alternate_member_order": "forbidden",
            "duplicate_members": "forbidden"
          },
          "signed_bytes": "UTF-8(\"ZipViz endpoint-proof v1\\0\") || RFC8785-JCS(body without signature)"
        },
        "responses": {
          "200": {
            "description": "card_url updated and an agent audit row appended."
          },
          "400": {
            "description": "Envelope shape or URL/DNS refusal (E_ADDRESS_SHAPE, E_ADDRESS_URL)."
          },
          "401": {
            "description": "Audience, stale timestamp, agent signature, or challenge failure."
          },
          "403": {
            "description": "Suspended or frozen."
          },
          "404": {
            "description": "Agent not found."
          },
          "409": {
            "description": "Nonce replay."
          },
          "413": {
            "description": "Body over 8192 bytes (E_ADDRESS_SHAPE)."
          },
          "429": {
            "description": "Per-agent hour cap or per-IP limiter."
          },
          "503": {
            "description": "Production flag is off (E_ADDRESS_DISABLED)."
          }
        },
        "callbacks": {
          "endpointProof": {
            "{$request.body#/new_url}/.well-known/zipviz/endpoint-proof": {
              "get": {
                "summary": "Endpoint proof the registry fetches from new_url",
                "description": "Query domain and challenge. No redirects; 5 s timeout. Anything but a valid 200 proof is 401 E_ADDRESS_CHALLENGE.",
                "parameters": [
                  {
                    "in": "query",
                    "name": "domain",
                    "required": true,
                    "schema": {
                      "type": "string"
                    }
                  },
                  {
                    "in": "query",
                    "name": "challenge",
                    "required": true,
                    "schema": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_-]{43}$"
                    }
                  }
                ],
                "responses": {
                  "200": {
                    "description": "The whole body is the RFC 8785 canonical serialization of the proof, at most 8192 bytes.",
                    "content": {
                      "application/json": {
                        "schema": {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "schema_version",
                            "type",
                            "domain",
                            "endpoint",
                            "challenge",
                            "audience",
                            "issued_at_ms",
                            "signature"
                          ],
                          "properties": {
                            "schema_version": {
                              "type": "string",
                              "const": "1.0"
                            },
                            "type": {
                              "type": "string",
                              "const": "zipviz.endpoint.proof"
                            },
                            "domain": {
                              "type": "string"
                            },
                            "endpoint": {
                              "type": "string",
                              "format": "uri",
                              "description": "Mailbox-configured canonical origin, never derived from Host."
                            },
                            "challenge": {
                              "type": "string",
                              "pattern": "^[A-Za-z0-9_-]{43}$"
                            },
                            "audience": {
                              "type": "string",
                              "enum": [
                                "api.zipviz.ai",
                                "api-staging.zipviz.ai"
                              ]
                            },
                            "issued_at_ms": {
                              "type": "integer",
                              "minimum": 0,
                              "maximum": 9007199254740991
                            },
                            "signature": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "alg",
                                "key_id",
                                "value_base64url"
                              ],
                              "properties": {
                                "alg": {
                                  "type": "string",
                                  "const": "Ed25519"
                                },
                                "key_id": {
                                  "type": "string",
                                  "pattern": "^sha256:[0-9a-f]{64}$"
                                },
                                "value_base64url": {
                                  "type": "string",
                                  "pattern": "^[A-Za-z0-9_-]{86}$"
                                }
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/verify": {
      "post": {
        "summary": "Verify an agent signature",
        "description": "Suspension overrides authority: 403 E_IDENTITY_SUSPENDED with verified:false. A stale/revoked external proof alone does not change the signature verdict. proven_by is additive on both the success and the signature-mismatch result. Request: JSON with from (the agent's .viz name), message, timestamp (ISO-8601, within ±5 minutes of the server clock) and signature. Sign the UTF-8 bytes of JSON.stringify({v: 1, from, message, timestamp}), keys in exactly that order, with the agent's registered Ed25519 key, and send the 64-byte signature base64-encoded. A signature is valid only when the response has verified === true. A signature mismatch also answers HTTP 200, with verified: false and code E_SIG_MISMATCH, so neither the HTTP status nor proven_by alone means the signature verified.",
        "responses": {
          "200": {
            "description": "Verification result. The signature is valid only when verified === true; a mismatch is also HTTP 200, with verified: false.",
            "content": {
              "application/json": {
                "schema": {
                  "oneOf": [
                    {
                      "title": "Signature verified",
                      "type": "object",
                      "required": [
                        "verified",
                        "identity",
                        "signing_version",
                        "freshness_checked",
                        "reputation",
                        "blue_tick",
                        "proven_by"
                      ],
                      "properties": {
                        "verified": {
                          "type": "boolean",
                          "const": true
                        },
                        "identity": {
                          "type": "string",
                          "description": "The verified agent's .viz name (the request's from)."
                        },
                        "signing_version": {
                          "type": "integer",
                          "description": "The signing protocol that verified: 1 for the canonical v1 payload."
                        },
                        "freshness_checked": {
                          "type": "boolean",
                          "const": true
                        },
                        "reputation": {
                          "type": [
                            "object",
                            "null"
                          ],
                          "description": "Reputation summary when available, otherwise null."
                        },
                        "blue_tick": {
                          "type": [
                            "boolean",
                            "null"
                          ],
                          "description": "Null when unavailable."
                        },
                        "proven_by": {
                          "type": "array",
                          "description": "Provenance of the canonical .viz name: what has been proven for it and when. Empty when nothing is recorded. Ordered by verified_at then id. A stale entry is shown, never hidden, and never changes \"verified\". A revoked entry is never reported.",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "type",
                              "subject",
                              "status",
                              "verified_at"
                            ],
                            "properties": {
                              "type": {
                                "type": "string",
                                "enum": [
                                  "operator",
                                  "invite",
                                  "namespace",
                                  "ans",
                                  "dns",
                                  "nostr_link",
                                  "handshake"
                                ]
                              },
                              "subject": {
                                "type": "string",
                                "description": "What is proven, normalised to lower case with no trailing dot: the outside name for an external type, and the literal \"operator\" or \"invite\" for an internal registration marker. The issuing .viz name behind an invite is never reported."
                              },
                              "status": {
                                "type": "string",
                                "enum": [
                                  "active",
                                  "stale",
                                  "revoked"
                                ]
                              },
                              "verified_at": {
                                "type": "integer",
                                "description": "Epoch milliseconds, as elsewhere in the registry."
                              }
                            }
                          }
                        }
                      }
                    },
                    {
                      "title": "Signature mismatch",
                      "type": "object",
                      "required": [
                        "verified",
                        "error",
                        "code",
                        "proven_by"
                      ],
                      "properties": {
                        "verified": {
                          "type": "boolean",
                          "const": false
                        },
                        "error": {
                          "type": "string"
                        },
                        "code": {
                          "type": "string",
                          "const": "E_SIG_MISMATCH"
                        },
                        "proven_by": {
                          "type": "array",
                          "description": "Provenance of the canonical .viz name: what has been proven for it and when. Empty when nothing is recorded. Ordered by verified_at then id. A stale entry is shown, never hidden, and never changes \"verified\". A revoked entry is never reported.",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": [
                              "type",
                              "subject",
                              "status",
                              "verified_at"
                            ],
                            "properties": {
                              "type": {
                                "type": "string",
                                "enum": [
                                  "operator",
                                  "invite",
                                  "namespace",
                                  "ans",
                                  "dns",
                                  "nostr_link",
                                  "handshake"
                                ]
                              },
                              "subject": {
                                "type": "string",
                                "description": "What is proven, normalised to lower case with no trailing dot: the outside name for an external type, and the literal \"operator\" or \"invite\" for an internal registration marker. The issuing .viz name behind an invite is never reported."
                              },
                              "status": {
                                "type": "string",
                                "enum": [
                                  "active",
                                  "stale",
                                  "revoked"
                                ]
                              },
                              "verified_at": {
                                "type": "integer",
                                "description": "Epoch milliseconds, as elsewhere in the registry."
                              }
                            }
                          }
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Invalid request: verified: false with code E_MISSING_FIELDS, E_TIMESTAMP_FORMAT, E_STALE or E_SIG_FORMAT.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "code"
                  ],
                  "properties": {
                    "verified": {
                      "type": "boolean",
                      "const": false
                    },
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "403": {
            "description": "Identity suspended: verified:false, blue_tick:false, reputation:null."
          },
          "404": {
            "description": "Agent not found: verified: false, E_AGENT_NOT_FOUND.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "code"
                  ],
                  "properties": {
                    "verified": {
                      "type": "boolean",
                      "const": false
                    },
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          },
          "413": {
            "description": "Request body exceeds 4 MiB (16 KiB when it names a scheme): verified:false, E_VERIFY_TOO_LARGE."
          },
          "429": {
            "description": "Public-surface rate limit."
          },
          "500": {
            "description": "Verification could not complete: E_STORED_KEY or E_VERIFY (verified: false), or E_PROOFS_DB.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "error",
                    "code"
                  ],
                  "properties": {
                    "verified": {
                      "type": "boolean",
                      "const": false
                    },
                    "error": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "from",
                  "message",
                  "timestamp",
                  "signature"
                ],
                "properties": {
                  "from": {
                    "type": "string",
                    "description": "The signing agent's .viz name."
                  },
                  "message": {
                    "type": "string"
                  },
                  "timestamp": {
                    "type": "string",
                    "format": "date-time",
                    "description": "ISO-8601, within ±5 minutes of the server clock."
                  },
                  "signature": {
                    "type": "string",
                    "description": "Base64 of the 64-byte Ed25519 signature over the canonical v1 payload."
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
