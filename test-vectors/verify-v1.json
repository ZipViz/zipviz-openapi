{
  "title": "ZipViz v1 signature test vectors for POST /v1/verify",
  "warning": "TEST ONLY. Both keys are published in RFC 8032 section 7.1 (TEST 1 and TEST 2). They are public, never register or trust them, never use them for anything real. All names are under example.test.viz.",
  "rule": {
    "signed_string": "JSON.stringify({v: 1, from, message, timestamp}), keys in exactly that order, encoded as UTF-8",
    "algorithm": "Ed25519 (RFC 8032), pure, no prehash",
    "signature": "base64 of the 64-byte signature",
    "public_key": "hex, 32 bytes",
    "timestamp": "ISO-8601, must be within +/-5 minutes of the verifier clock (now)"
  },
  "test_keys": {
    "TEST 1": {
      "source": "RFC 8032 section 7.1, TEST 1",
      "secret_key": "9d61b19deffd5a60ba844af492ec2cc44449c5697b326919703bac031cae7f60",
      "public_key": "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a"
    },
    "TEST 2": {
      "source": "RFC 8032 section 7.1, TEST 2",
      "secret_key": "4ccd089b28ff96da9db6c346ec114e0f5b8a319f35aba624da8cf6ed4fb8a6fb",
      "public_key": "3d4017c3e843895a92b70aa74d1b7ebc9c982ccf2ec4968cc0cd55f12af4660c"
    }
  },
  "cases": [
