      },
      "signed_string": "{\"v\":1,\"from\":\"example.test.viz\",\"message\":\"Hello from the ZipViz v1 test vectors!\",\"timestamp\":\"2026-11-18T00:59:30.000Z\"}",
      "signature_made_over": "{\"v\":1,\"from\":\"example.test.viz\",\"message\":\"Hello from the ZipViz v1 test vectors\",\"timestamp\":\"2026-11-18T00:59:30.000Z\"}",
      "signed_with": "TEST 1",
      "expected": {
        "valid": false,
        "reason": "E_SIG_MISMATCH"
      }
    },
    {
