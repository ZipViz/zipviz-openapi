      "now": "2026-11-18T01:00:00.000Z",
      "request": {
        "from": "example.test.viz",
        "message": "Hello from the ZipViz v1 test vectors",
        "timestamp": "2026-11-18T00:59:30.000Z",
        "signature": "I/lWCzfBPR3t2KNxYv2O5oGvpIfMoPWyzBmbwVU3tMVcpw1pzWRHxZnkN2I7Fl96wqlgJBoDTRzAD3RRMD3zCA=="
      },
      "signed_string": "{\"v\":1,\"from\":\"example.test.viz\",\"message\":\"Hello from the ZipViz v1 test vectors\",\"timestamp\":\"2026-11-18T00:59:30.000Z\"}",
      "signed_with": "TEST 1",
      "expected": {
        "valid": true,
        "reason": null
      }
    },
    {
      "name": "message_tampered",
      "description": "Valid signature, but message was altered after signing.",
      "public_key": "d75a980182b10ab7d54bfed3c964073a0ee172f3daa62325af021a68f707511a",
      "now": "2026-11-18T01:00:00.000Z",
      "request": {
        "from": "example.test.viz",
        "message": "Hello from the ZipViz v1 test vectors!",
        "timestamp": "2026-11-18T00:59:30.000Z",
